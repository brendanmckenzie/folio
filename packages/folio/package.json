{
  "name": "folio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native block CMS with a live visual editor",
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "esbuild core=src/core/index.ts engine=src/core/engine.ts server=src/server/index.tsx vite=src/vite/index.ts --bundle --splitting --format=esm --platform=neutral --packages=external --target=es2022 --sourcemap --outdir=dist --tsconfig=tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "prepare": "npm run build:js && npm run build:types",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": ["dist", "src", "migrations"],
  "exports": {
    "./core": {
      "development": "./src/core/index.ts",
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/core.js"
    },
    "./engine": {
      "development": "./src/core/engine.ts",
      "types": "./dist/types/core/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./server": {
      "development": "./src/server/index.tsx",
      "types": "./dist/types/server/index.d.ts",
      "default": "./dist/server.js"
    },
    "./vite": {
      "development": "./src/vite/index.ts",
      "types": "./dist/types/vite/index.d.ts",
      "default": "./dist/vite.js"
    },
    "./render": "./src/preview/Render.tsx",
    "./preview": "./src/preview/mount.tsx",
    "./admin-entry": "./src/admin/main.tsx"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "vite": "^7 || ^8"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.0",
    "@tiptap/extension-subscript": "^3.29.0",
    "@tiptap/extension-superscript": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.12.32",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
