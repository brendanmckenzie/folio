{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "folio-demo",
  "main": "./src/index.tsx",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folio",
      // Replace with the id from `wrangler d1 create folio` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Structure only, no seed rows: `wrangler d1 migrations apply` runs these
      // in order and records what it applied, so it never re-runs a migration
      // and never drops a table, which the old schema.sql did every time. Seed
      // rows live in ./seed.sql and are applied separately, by `pnpm db:seed`.
      // Points at the folio package's copy so this project and any other
      // consumer share one migration history. A database created by the old
      // schema.sql has no bookkeeping table, so the first apply against it runs
      // every migration: 0001 is written to adopt it, and 0002 has one data
      // precondition — see the notes in those two files.
      "migrations_dir": "../../packages/folio/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "STORY", "class_name": "StoryDO" }]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "folio-media"
    }
  ],
  // Without this, assets serve at their original size. `wrangler dev` supports
  // it locally and does not bill transformations there.
  "images": {
    "binding": "IMAGES"
  },
  // SQLite-backed DOs must be declared as such at creation; this cannot be
  // changed for an already-deployed class.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoryDO"] }]
}
