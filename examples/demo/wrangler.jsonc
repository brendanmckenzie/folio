{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "folio-demo",
  "main": "./src/index.tsx",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Workers Cache (docs/specs/platform/caching.md). The whole of the host's
  // opt-in: no binding, no API token, no zone, no paid plan. With it, a
  // response carrying the `Cache-Control`/`Cache-Tag` pair `folio.cacheHeaders`
  // returns is stored at the edge, and `cache.purge({ tags })` from inside the
  // Worker invalidates it globally when the page is published.
  //
  // Without this key the two headers are inert and every purge is a no-op, so
  // the site behaves exactly as it did before — which is what makes it safe for
  // a host to adopt the headers first and the flag second.
  //
  // Nothing here is observable locally: miniflare simulates no part of Workers
  // Cache, so `wrangler dev` never reports a HIT and `scripts/cache-probe.mjs`
  // needs a real deployment.
  "cache": {
    "enabled": true
  },
  // Scheduled publish and unpublish (docs/specs/platform/scheduled-publishing.md).
  // **This key plus the `scheduled()` handler in src/index.tsx is the whole of the
  // host's integration** — no queue, no polling loop, no external cron service.
  //
  // Every minute, which is the finest granularity Cloudflare cron offers and is
  // best-effort within it. That is the granularity of the feature: a schedule fires
  // on the first sweep at or after its due time, so it is never early and is late by
  // at most one tick. "9:00" means "9:00, give or take the minute", which is the
  // right trade for a CMS publishing a press release.
  //
  // Rejected: a Durable Object alarm per story, which ROADMAP.md predicted. A
  // Durable Object has exactly one alarm and StoryDO already spends it on the
  // debounced draft watermark — see server/scheduler.ts's header for the two ways
  // that collides.
  //
  // A minute is also cheap because a site with nothing scheduled pays for one
  // indexed read over an *empty* partial index (`schedules_due`). Widen it to
  // "*/5 * * * *" if a five-minute window is close enough; nothing in Folio assumes
  // the period.
  //
  // Locally, `wrangler dev` does not run crons on a timer. `POST
  // /folio/api/schedules/run` is the manual trigger, which is what
  // scripts/scheduled-test.mjs uses.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folio",
      // Replace with the id from `wrangler d1 create folio` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Structure only, no seed rows: `wrangler d1 migrations apply` runs these
      // in order and records what it applied, so it never re-runs a migration
      // and never drops a table, which the old schema.sql did every time. Seed
      // rows live in ./seed.sql and are applied separately, by `pnpm db:seed`.
      // Points at the folio package's copy so this project and any other
      // consumer share one migration history. `0001_init.sql` is the whole schema
      // in one file — the ten that preceded it were collapsed into it, and it uses
      // plain `create table` rather than `if not exists` on purpose, so applying it
      // over an existing database fails loudly and the fix is to reset.
      "migrations_dir": "../../packages/folio/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "STORY", "class_name": "StoryDO" },
      // The space channel (editing/live-collaboration.md): cross-story presence
      // and structural events. Optional — Folio degrades to per-story presence
      // and a tree you refresh yourself without it — but there is no reason for a
      // real deployment not to have it.
      { "name": "SPACE", "class_name": "SpaceDO" }
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "folio-media"
    }
  ],
  // Without this, assets serve at their original size. `wrangler dev` supports
  // it locally and does not bill transformations there.
  "images": {
    "binding": "IMAGES"
  },
  // SQLite-backed DOs must be declared as such at creation; this cannot be
  // changed for an already-deployed class. Hence a second tag for SpaceDO rather
  // than an edit to v1 — and `new_classes`, not `new_sqlite_classes`, because
  // SpaceDO holds no storage at all: presence lives in socket attachments and
  // nothing it knows outlives the sockets (live-collaboration.md decision 1). A
  // smaller commitment than StoryDO's, and equally permanent.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StoryDO"] },
    { "tag": "v2", "new_classes": ["SpaceDO"] }
  ]
}
