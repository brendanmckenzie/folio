{
  "name": "folio",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native block CMS with a live visual editor",
  "license": "MIT",
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "node scripts/build-admin.mjs && esbuild core=src/core/index.ts engine=src/core/engine.ts server=src/server/index.tsx vite=src/vite/index.ts form=src/form/index.ts render=src/preview/Render.tsx preview=src/preview/mount.tsx --bundle --splitting --format=esm --platform=neutral --packages=external --target=es2022 --sourcemap --sources-content=true --outdir=dist --loader:.css=copy --asset-names=[name] --tsconfig=tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json && node scripts/strip-css-import.mjs",
    "build:demo": "pnpm --filter demo build",
    "clean": "rm -rf dist",
    "prepare": "npm run clean && npm run build:js && npm run build:types",
    "typecheck": "tsc --noEmit -p . && pnpm --filter demo typecheck && pnpm --filter folio-starter typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "bin": {
    "folio": "./bin/folio.mjs"
  },
  "files": [
    "dist",
    "migrations",
    "bin",
    "evals",
    "src/server/describe-anthropic.ts",
    "src/server/llm-tasks.ts",
    "src/server/llm-tasks.json",
    "examples/starter",
    "!examples/starter/node_modules",
    "!examples/starter/.wrangler",
    "!examples/starter/dist",
    "README.md",
    "AGENTS.md",
    "UPGRADING.md",
    "CHANGELOG.md",
    "upgrade-ledger.json",
    "docs/api.md",
    "docs/mcp.md",
    "docs/configuration.md",
    "docs/handbook.md"
  ],
  "exports": {
    "./core": {
      "folio-source": "./src/core/index.ts",
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/core.js"
    },
    "./engine": {
      "folio-source": "./src/core/engine.ts",
      "types": "./dist/types/core/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./server": {
      "folio-source": "./src/server/index.tsx",
      "types": "./dist/types/server/index.d.ts",
      "default": "./dist/server.js"
    },
    "./vite": {
      "folio-source": "./src/vite/index.ts",
      "types": "./dist/types/vite/index.d.ts",
      "default": "./dist/vite.js"
    },
    "./form": {
      "folio-source": "./src/form/index.ts",
      "types": "./dist/types/form/index.d.ts",
      "default": "./dist/form.js"
    },
    "./render": {
      "folio-source": "./src/preview/Render.tsx",
      "types": "./dist/types/preview/Render.d.ts",
      "default": "./dist/render.js"
    },
    "./preview": {
      "folio-source": "./src/preview/mount.tsx",
      "types": "./dist/types/preview/mount.d.ts",
      "default": "./dist/preview.js"
    },
    "./admin-entry": "./dist/admin/folio-admin.js"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.1.6 ^8.1.6"
  },
  "dependencies": {
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.16",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
